# Copy to .env and adjust. .env is gitignored; this file is committed.

NODE_ENV=development
PORT=5000

# Local mongod, or an Atlas string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/splitbook
MONGO_URI=mongodb://127.0.0.1:27017/splitbook

# The frontend origin(s) allowed by CORS. Comma-separate several, e.g. a Vercel
# production URL and localhost:  https://splitbook.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Set to the number of proxies in front of the app (1 on Render).
# Leave at 0 for local development. express-rate-limit THROWS if this is `true`,
# which is why it is a count and not a boolean.
TRUST_PROXY=0

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs our JWTs. Generate with:  openssl rand -hex 32
# This is the only place the secret lives; nothing reads process.env but config/index.ts.
JWT_SECRET=change-me-openssl-rand-hex-32

# The absolute cap on a token's life, however active the user is. There is no
# refresh token in the MVP, so after this the user logs in again.
JWT_EXPIRES_IN=1d

# A session ends after this many minutes with no authenticated request. Every
# request resets the clock, so an active user is never logged out by it.
SESSION_IDLE_MINUTES=60

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH=20
